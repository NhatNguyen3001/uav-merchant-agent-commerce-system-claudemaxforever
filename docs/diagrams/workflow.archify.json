    {
      "dot": "rose",
      "title": "The model proposes, the rules decide",
      "items": [
        "Four checks run in code: identity, catalogue, outbound, execution",
        "Any of them can stop the run, and the buyer is told why"
      ]
    },
    {
      "dot": "cyan",
      "title": "Nothing is invented",
      "items": [
        "Every price and delivery day comes from a catalogue lookup in that run",
        "The discount cap and margin floor are never shown to the model"
      ]
    },
    {
      "dot": "amber",
      "title": "At most two rounds",
      "items": [
        "The buyer's agent may counter once before the final offer",
        "No order is written unless it accepts"
      ]
    }
