  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Hard merchant rules are read only by the gates and never enter a prompt",
        "Every gate verdict is a fixed rule; the model proposes, the gate decides"
      ]
    },
    {
      "dot": "cyan",
      "title": "Traceability",
      "items": [
        "Every price and shipping figure carries the id of the tool result it came from",
        "Every event is persisted per run, so history and replay read the same stream"
      ]
    },
    {
      "dot": "amber",
      "title": "Delivery",
      "items": [
        "Cloud Build to Artifact Registry to Cloud Run, key from Secret Manager",
        "Console built with the Cloud Run URL so SSE bypasses Hosting rewrites"
      ]
    }
  ]
