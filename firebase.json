{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "macs-api", "region": "australia-southeast1" } },
      { "source": "/health", "run": { "serviceId": "macs-api", "region": "australia-southeast1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
